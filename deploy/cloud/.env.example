# NOT a deploy-ready environment. No secrets are supplied.
# Reviewed copy belongs in /etc/rehabaffect/cloud.env, root-only mode 0600.
CLOUD_MIGRATION_APPROVED=no
# Fill from the approved preserved-database baseline; both must be positive.
CLOUD_MIN_ACCOUNT_COUNT=
CLOUD_MIN_TASK_COUNT=
TZ=Asia/Shanghai
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
REHAB_DEMO2_DB_PATH=/var/lib/rehabaffect/seewo_demo2/rehab_affect_demo2.sqlite3
REHAB_DEMO2_UPLOAD_DIR=/var/lib/rehabaffect/seewo_demo2/student_documents
REHAB_DEMO2_MEDIA_WORKER=1
REHAB_DEMO2_RETENTION_SCAN_SECONDS=3600
REHAB_DEMO2_COURSE_UPLOAD_LIMIT=5
# Explicitly empty -> encryption/startup fails closed until migrated key is supplied.
REHAB_DEMO2_DOSSIER_KEY=
# Verify these approved Linux binaries, do not assume distro-version compatibility.
REHAB_FFMPEG=/usr/local/bin/ffmpeg
REHAB_FFPROBE=/usr/local/bin/ffprobe
# Do NOT seed replacement accounts or configure third-party model APIs here.
